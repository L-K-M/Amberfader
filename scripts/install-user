#!/usr/bin/env bash
# Amberfader per-user installer (no sudo).
#
# Installs the Python app under ~/.local/share/amberfader, registers the
# native-messaging host with Firefox — deb/rpm AND Flatpak packaging are both
# supported — installs launcher scripts and a desktop entry. Idempotent: run
# it again to update.
#
#   deb/rpm Firefox:  manifest in ~/.mozilla/native-messaging-hosts/, helper path
#                     is the real venv executable.
#   Flatpak Firefox:  manifest in ~/.var/app/org.mozilla.firefox/.mozilla/
#                     native-messaging-hosts/, path is a launcher that re-enters
#                     the host via `flatpak-spawn --host`. The sandbox needs the
#                     org.freedesktop.Flatpak talk permission (this script tells
#                     you if it's missing; the extension keeps working without
#                     native mode either way).
#
# Usage: scripts/install-user [--app source|flatpak] [--firefox auto|native|flatpak|both]
#                             [--prefix DIR] [--python BIN] [--no-venv]
#   auto (default) detects Firefox and Zen. --app flatpak registers an installed
#   Flatpak app without installing Python or replacing its desktop launcher.
set -euo pipefail

PREFIX="$HOME/.local/share/amberfader"
FIREFOX_MODE="auto"
PYTHON_BIN="python3"
NO_VENV=0
HOST_NAME="amberfader"
ADDON_ID="amberfader@ch.lkmc"
APP_ID="ch.lkmc.amberfader"
APP_MODE="source"
FIREFOX_FLATPAK_ID="org.mozilla.firefox"
FLATPAK_BROWSER_IDS=("$FIREFOX_FLATPAK_ID" "app.zen_browser.zen" "io.github.zen_browser.zen")

while [[ $# -gt 0 ]]; do
  case "$1" in
    --app) APP_MODE="${2:?}"; shift 2 ;;
    --firefox) FIREFOX_MODE="${2:?}"; shift 2 ;;
    --prefix) PREFIX="${2:?}"; shift 2 ;;
    --python) PYTHON_BIN="${2:?}"; shift 2 ;;
    --no-venv) NO_VENV=1; shift ;;
    -h|--help) sed -n '2,21p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "!! unknown option: $1" >&2; exit 2 ;;
  esac
done

say()  { echo "==> $*"; }
warn() { echo "!! $*" >&2; }
note() { echo "-- $*"; }

# ---- python environment ---------------------------------------------------

PYENV="$PREFIX/venv"
case "$APP_MODE" in
  source) cd "$(dirname "$0")/.." ;;
  flatpak)
    command -v "$PYTHON_BIN" >/dev/null 2>&1 || {
      warn "--app flatpak needs '$PYTHON_BIN' on the host to write manifests"; exit 1; }
    flatpak info "$APP_ID" >/dev/null 2>&1 || {
      warn "Flatpak Amberfader is not installed ($APP_ID)"; exit 1; }
    ;;
  *) warn "--app must be source|flatpak"; exit 2 ;;
esac

if [[ $APP_MODE == source && $NO_VENV -eq 0 ]]; then
  if command -v uv >/dev/null 2>&1; then
    say "creating venv with uv ($PYENV)"
    uv venv "$PYENV" --python "$PYTHON_BIN" >/dev/null
    UV_PIP="uv pip install --python $PYENV/bin/python"
  else
    say "creating venv ($PYENV)"
    "$PYTHON_BIN" -m venv "$PYENV"
    UV_PIP="$PYENV/bin/pip install"
  fi
  say "installing amberfader[gui] into the venv"
  $UV_PIP --quiet ".[gui]"
  PYTHON="$PYENV/bin/python"
elif [[ $APP_MODE == source ]]; then
  PYTHON="$PYTHON_BIN"
  "$PYTHON" -c 'import amberfader, jsonschema' 2>/dev/null || {
    warn "--no-venv but the amberfader package is not importable by $PYTHON"; exit 1; }
fi

# ---- launchers ------------------------------------------------------------

BINDIR="$PREFIX/bin"
mkdir -p "$BINDIR"

if [[ $APP_MODE == flatpak ]]; then
  cat > "$BINDIR/amberfader-helper" <<EOF
#!/bin/sh
exec flatpak run --command=amberfader-helper "$APP_ID" "\$@"
EOF
  cat > "$BINDIR/amberfader" <<EOF
#!/bin/sh
exec flatpak run "$APP_ID" "\$@"
EOF
  cat > "$BINDIR/amberfader-face-editor" <<EOF
#!/bin/sh
exec flatpak run --command=amberfader-face-editor "$APP_ID" "\$@"
EOF
  if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
    mkdir -p "$XDG_RUNTIME_DIR/$HOST_NAME"
    chmod 700 "$XDG_RUNTIME_DIR/$HOST_NAME"
  fi
else
  cat > "$BINDIR/amberfader-helper" <<EOF
#!/bin/sh
exec "$PYTHON" -m amberfader.helper "\$@"
EOF
  cat > "$BINDIR/amberfader" <<EOF
#!/bin/sh
exec "$PYTHON" -m amberfader.app "\$@"
EOF
  cat > "$BINDIR/amberfader-face-editor" <<EOF
#!/bin/sh
exec "$PYTHON" -m amberfader.editor_app "\$@"
EOF
fi
cat > "$BINDIR/amberfader-helper-flatpak" <<EOF
#!/bin/sh
# Re-enter the host; its launcher chooses the source helper or Flatpak app.
exec flatpak-spawn --host "$BINDIR/amberfader-helper" "\$@"
EOF
chmod +x "$BINDIR/amberfader" "$BINDIR/amberfader-helper" "$BINDIR/amberfader-helper-flatpak" \
  "$BINDIR/amberfader-face-editor"

# ---- detection -------------------------------------------------------------

have_native_firefox() {
  command -v firefox >/dev/null 2>&1 && ! flatpak info org.mozilla.firefox >/dev/null 2>&1 && return 0
  [[ -d "$HOME/.mozilla" && ! "$(readlink -f "$(command -v firefox 2>/dev/null || echo /none)" 2>/dev/null)" == */flatpak/* ]] && return 0
  [[ -d "$HOME/.mozilla" ]] && return 0
  return 1
}
have_native_zen() {
  command -v zen >/dev/null 2>&1 && return 0
  [[ -d "$HOME/.zen" || -d "$HOME/.config/zen" ]] && return 0
  return 1
}

DO_NATIVE=0
DETECTED_FLATPAK_BROWSERS=()
case "$FIREFOX_MODE" in
  auto)
    if have_native_firefox || have_native_zen; then DO_NATIVE=1; fi
    for id in "${FLATPAK_BROWSER_IDS[@]}"; do
      if flatpak info "$id" >/dev/null 2>&1 || [[ -d "$HOME/.var/app/$id" ]]; then
        DETECTED_FLATPAK_BROWSERS+=("$id")
      fi
    done
    if [[ $DO_NATIVE -eq 0 && ${#DETECTED_FLATPAK_BROWSERS[@]} -eq 0 ]]; then
      warn "no Firefox or Zen installation detected; registering the native manifest anyway"
      DO_NATIVE=1
    fi
    ;;
  native) DO_NATIVE=1 ;;
  flatpak) DETECTED_FLATPAK_BROWSERS=("$FIREFOX_FLATPAK_ID") ;;
  both) DO_NATIVE=1; DETECTED_FLATPAK_BROWSERS=("$FIREFOX_FLATPAK_ID") ;;
  *) warn "--firefox must be auto|native|flatpak|both"; exit 2 ;;
esac

write_manifest() { # target_dir helper_path
  mkdir -p "$1"
  "$PYTHON_BIN" - "$1/$HOST_NAME.json" "$2" "$HOST_NAME" "$ADDON_ID" <<'PY'
import json
import sys
with open(sys.argv[1], "w", encoding="utf-8") as output:
    json.dump({"name": sys.argv[3], "description": "Amberfader native messaging host",
               "path": sys.argv[2], "type": "stdio", "allowed_extensions": [sys.argv[4]]},
              output, indent=2)
    output.write("\n")
PY
  note "wrote $1/$HOST_NAME.json"
}

# ---- deb/rpm ---------------------------------------------------------

if [[ $DO_NATIVE -eq 1 ]]; then
  say "registering native host for native Firefox/Zen"
  write_manifest "$HOME/.mozilla/native-messaging-hosts" "$BINDIR/amberfader-helper"
fi

# ---- flatpak ---------------------------------------------------------

for id in ${DETECTED_FLATPAK_BROWSERS[@]+"${DETECTED_FLATPAK_BROWSERS[@]}"}; do
  say "registering native host for Flatpak $id"
  FPDIR="$HOME/.var/app/$id/.mozilla/native-messaging-hosts"
  mkdir -p "$FPDIR"
  # Gecko searches .mozilla even when Zen's profile is .zen. Place the
  # launcher in that persisted subtree so the browser can execute it.
  cp "$BINDIR/amberfader-helper-flatpak" "$FPDIR/amberfader-helper"
  write_manifest "$FPDIR" "$HOME/.mozilla/native-messaging-hosts/amberfader-helper"
  if flatpak info --show-permissions "$id" 2>/dev/null \
        | grep -q 'org.freedesktop.Flatpak'; then
    note "flatpak-spawn permission present"
  else
    warn "Flatpak $id lacks the org.freedesktop.Flatpak talk permission."
    warn "Native mode cannot reach the host helper until you run:"
    warn "  flatpak override --user $id --talk-name=org.freedesktop.Flatpak --persist=.mozilla"
    warn "The extension-only player keeps working without it."
  fi
  if [[ $id != "$FIREFOX_FLATPAK_ID" ]]; then
    note "Zen must persist Gecko's native-host directory. Run:"
    note "  flatpak override --user $id --persist=.mozilla --talk-name=org.freedesktop.Flatpak"
    note "Restart Zen after changing its Flatpak permissions."
  fi
done

if [[ $APP_MODE == flatpak ]]; then
  say "registration complete"
  note "Restart Amberfader, then press Reconnect in the extension options."
  exit 0
fi

# ---- desktop entry ----------------------------------------------------

APPS="$HOME/.local/share/applications"
mkdir -p "$APPS"
cat > "$APPS/ch.lkmc.amberfader.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Amberfader
Comment=Classic-style remote for YouTube Music in Firefox
Exec=$BINDIR/amberfader
Icon=amberfader
Terminal=false
Categories=Audio;Music;Player;
StartupWMClass=amberfader
EOF
note "wrote $APPS/ch.lkmc.amberfader.desktop"

say "done"
note "next: load the extension (see README 'ext:run' for dev, or install the signed add-on),"
note "then enable native mode in the extension options. scripts/doctor verifies the setup."
