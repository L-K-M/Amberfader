#!/usr/bin/env bash
# Removes Amberfader's per-user installation: native-messaging manifests
# (deb/rpm AND Flatpak locations), the desktop entry, launchers and the venv.
# Preferences under ~/.config/amberfader are kept unless --purge is given.
# Firefox itself and your listening data are never touched.
#
# Usage: scripts/uninstall-user [--prefix DIR] [--purge]
set -euo pipefail

PREFIX="$HOME/.local/share/amberfader"
PURGE=0
HOST_NAME="amberfader"
FLATPAK_BROWSER_IDS=("org.mozilla.firefox" "app.zen_browser.zen" "io.github.zen_browser.zen")
while [[ $# -gt 0 ]]; do
  case "$1" in
    --prefix) PREFIX="${2:?}"; shift 2 ;;
    --purge) PURGE=1; shift ;;
    -h|--help) sed -n '2,8p' "$0" | sed 's/^# \?//'; exit 0 ;;
    *) echo "!! unknown option: $1" >&2; exit 2 ;;
  esac
done

say() { echo "==> $*"; }

remove() {
  if [[ -e "$1" ]]; then rm -rf "$1"; echo "-- removed $1"; fi
}

say "removing native-messaging manifests"
remove "$HOME/.mozilla/native-messaging-hosts/$HOST_NAME.json"
for id in "${FLATPAK_BROWSER_IDS[@]}"; do
  remove "$HOME/.var/app/$id/.mozilla/native-messaging-hosts/$HOST_NAME.json"
  remove "$HOME/.var/app/$id/.mozilla/native-messaging-hosts/amberfader-helper"
done

say "removing desktop entry + app files"
remove "$HOME/.local/share/applications/ch.lkmc.amberfader.desktop"
remove "$PREFIX"

if [[ $PURGE -eq 1 ]]; then
  remove "$HOME/.config/amberfader"
  remove "${XDG_RUNTIME_DIR:-/nonexistent}/amberfader/control.sock"
fi

say "done (preferences $([ $PURGE -eq 1 ] && echo removed || echo kept under ~/.config/amberfader))"
