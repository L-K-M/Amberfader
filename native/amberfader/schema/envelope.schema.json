{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amberfader.ch.lkmc/protocol/envelope.schema.json",
  "title": "Amberfader protocol envelope",
  "description": "All messages on every hop (UI page -> router, controller <-> helper, helper <-> GUI) are validated against this schema. Per-hop rules enforced in code, not here: sessionId/bindingToken matching, sender roles, deadlines.",
  "$defs": {
    "playbackStatus": {
      "enum": ["playing", "paused", "buffering", "ended", "unknown"]
    },
    "capability": {
      "enum": ["play", "pause", "previous", "next", "seek", "volume", "setLiked", "searchSongs", "playSearchResult", "startRadio"]
    },
    "playerState": {
      "type": "object",
      "required": ["bindingToken", "revision", "track", "status", "contentKind", "positionSeconds", "durationSeconds", "playbackRate", "volume", "muted", "capabilities"],
      "additionalProperties": false,
      "properties": {
        "bindingToken": { "type": "string", "minLength": 1 },
        "revision": { "type": "integer", "minimum": 0 },
        "track": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["occurrenceId", "providerId", "title", "artists", "album", "artworkId"],
              "additionalProperties": false,
              "properties": {
                "occurrenceId": { "type": "string", "minLength": 1 },
                "providerId": { "type": ["string", "null"] },
                "title": { "type": "string" },
                "artists": { "type": "array", "items": { "type": "string" } },
                "album": { "type": ["string", "null"] },
                "artworkId": { "type": ["string", "null"] }
              }
            }
          ]
        },
        "status": { "$ref": "#/$defs/playbackStatus" },
        "contentKind": { "enum": ["track", "advertisement", "unknown"] },
        "positionSeconds": { "type": ["number", "null"], "minimum": 0 },
        "durationSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "playbackRate": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "volume": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "muted": { "type": ["boolean", "null"] },
        "liked": { "type": ["boolean", "null"] },
        "capabilities": { "type": "array", "items": { "$ref": "#/$defs/capability" }, "uniqueItems": true }
      }
    },
    "searchResult": {
      "type": "object",
      "required": ["resultId", "kind", "title", "artists", "album", "durationSeconds", "supported", "artworkId"],
      "additionalProperties": false,
      "properties": {
        "resultId": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["song", "album", "playlist", "artist", "video", "other"] },
        "title": { "type": "string" },
        "artists": { "type": "array", "items": { "type": "string" } },
        "album": { "type": ["string", "null"] },
        "durationSeconds": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "supported": { "type": "boolean" },
        "radioSupported": { "type": "boolean" },
        "artworkId": { "type": ["string", "null"] }
      }
    },
    "errorCode": {
      "enum": [
        "validation_error",
        "unsupported_operation",
        "timeout",
        "pending_outcome",
        "stale_target",
        "stale_result",
        "missing_permission",
        "authentication_required",
        "user_interaction_required",
        "version_incompatible",
        "disconnected",
        "internal_error"
      ]
    },
    "protocolVersion": { "const": 1 },
    "emptyParams": {
      "type": "object",
      "additionalProperties": false
    },
    "playerSeekParams": {
      "type": "object",
      "required": ["occurrenceId", "positionSeconds"],
      "additionalProperties": false,
      "properties": {
        "occurrenceId": { "type": "string", "minLength": 1 },
        "positionSeconds": { "type": "number", "minimum": 0, "exclusiveMaximum": 86400 }
      }
    },
    "playerSetVolumeParams": {
      "type": "object",
      "required": ["volume"],
      "additionalProperties": false,
      "properties": {
        "volume": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "playerSetMutedParams": {
      "type": "object",
      "required": ["muted"],
      "additionalProperties": false,
      "properties": {
        "muted": { "type": "boolean" }
      }
    },
    "playerSetLikedParams": {
      "type": "object",
      "required": ["occurrenceId", "liked"],
      "additionalProperties": false,
      "properties": {
        "occurrenceId": { "type": "string", "minLength": 1 },
        "liked": { "type": "boolean" }
      }
    },
    "searchHistory": {
      "type": "object",
      "required": ["queries", "artists"],
      "additionalProperties": false,
      "properties": {
        "queries": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "artists": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "targetsSelectParams": {
      "type": "object",
      "required": ["targetKey"],
      "additionalProperties": false,
      "properties": {
        "targetKey": { "type": "string", "minLength": 1 }
      }
    },
    "searchSongsParams": {
      "type": "object",
      "required": ["query"],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "searchPlayResultParams": {
      "type": "object",
      "required": ["searchToken", "resultId"],
      "additionalProperties": false,
      "properties": {
        "searchToken": { "type": "string", "minLength": 1 },
        "resultId": { "type": "string", "minLength": 1 }
      }
    },
    "searchSongsResult": {
      "type": "object",
      "required": ["searchToken", "complete", "results"],
      "additionalProperties": false,
      "properties": {
        "searchToken": { "type": "string", "minLength": 1 },
        "complete": { "type": "boolean" },
        "results": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/searchResult" } }
      }
    },
    "targetsListResult": {
      "type": "object",
      "required": ["targets"],
      "additionalProperties": false,
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["targetKey", "label", "audible", "selected"],
            "additionalProperties": false,
            "properties": {
              "targetKey": { "type": "string", "minLength": 1 },
              "label": { "type": "string" },
              "audible": { "type": "boolean" },
              "selected": { "type": "boolean" }
            }
          }
        }
      }
    },
    "hello": {
      "type": "object",
      "required": ["protocolVersion", "kind", "component", "componentVersion"],
      "additionalProperties": false,
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "kind": { "const": "hello" },
        "component": { "enum": ["ui", "helper", "gui-instance", "controller"] },
        "componentVersion": { "type": "string", "minLength": 1 },
        "instanceId": { "type": "string" },
        "profileId": { "type": "string" }
      }
    },
    "request": {
      "type": "object",
      "required": ["protocolVersion", "kind", "id", "method", "params"],
      "additionalProperties": false,
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "kind": { "const": "request" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string" },
        "bindingToken": { "type": "string" },
        "method": {
          "enum": [
            "connection.ping",
            "state.get",
            "state.subscribe",
            "state.unsubscribe",
            "targets.list",
            "targets.select",
            "player.play",
            "player.pause",
            "player.previous",
            "player.next",
            "player.seek",
            "player.setVolume",
            "player.setMuted",
            "player.setLiked",
            "search.songs",
            "search.playResult",
            "search.startRadio",
            "search.history",
            "search.clearHistory",
            "browser.showPlayer",
            "browser.hidePlayer"
          ]
        },
        "params": { "type": "object" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "player.play",
                  "player.pause",
                  "player.previous",
                  "player.next",
                  "player.seek",
                  "player.setVolume",
                   "player.setMuted",
                   "player.setLiked",
                   "search.songs",
                   "search.playResult",
                   "search.startRadio",
                  "browser.showPlayer",
                  "browser.hidePlayer"
                ]
              }
            },
            "required": ["method"]
          },
          "then": { "required": ["bindingToken", "sessionId"] }
        },
        {
          "if": { "properties": { "method": { "const": "player.seek" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/playerSeekParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "player.setVolume" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/playerSetVolumeParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "player.setMuted" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/playerSetMutedParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "player.setLiked" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/playerSetLikedParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "targets.select" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/targetsSelectParams" } } }
        },
        {
          "if": { "properties": { "method": { "const": "search.songs" } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/searchSongsParams" } } }
        },
        {
          "if": { "properties": { "method": { "enum": ["search.playResult", "search.startRadio"] } }, "required": ["method"] },
          "then": { "properties": { "params": { "$ref": "#/$defs/searchPlayResultParams" } } }
        },
        {
          "if": {
            "properties": {
              "method": {
                "enum": [
                  "connection.ping",
                  "state.get",
                  "state.unsubscribe",
                   "targets.list",
                   "search.history",
                   "search.clearHistory",
                  "player.play",
                  "player.pause",
                  "player.previous",
                  "player.next",
                  "browser.showPlayer",
                  "browser.hidePlayer"
                ]
              }
            },
            "required": ["method"]
          },
          "then": { "properties": { "params": { "$ref": "#/$defs/emptyParams" } } }
        }
      ]
    },
    "response": {
      "type": "object",
      "required": ["protocolVersion", "kind", "id", "ok"],
      "additionalProperties": false,
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "kind": { "const": "response" },
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sessionId": { "type": "string" },
        "bindingToken": { "type": "string" },
        "ok": { "type": "boolean" },
        "result": { "type": ["object", "null"] },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "additionalProperties": false,
          "properties": {
            "code": { "$ref": "#/$defs/errorCode" },
            "message": { "type": "string", "maxLength": 1000 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "ok": { "const": true } }, "required": ["ok"] },
          "then": { "required": ["result"], "not": { "required": ["error"] } }
        },
        {
          "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
          "then": { "required": ["error"], "not": { "required": ["result"] } }
        }
      ]
    },
    "event": {
      "type": "object",
      "required": ["protocolVersion", "kind", "event", "data"],
      "additionalProperties": false,
      "properties": {
        "protocolVersion": { "$ref": "#/$defs/protocolVersion" },
        "kind": { "const": "event" },
        "sessionId": { "type": "string" },
        "bindingToken": { "type": "string" },
        "event": { "enum": ["state", "asset", "connection", "binding"] },
        "data": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "event": { "const": "state" } }, "required": ["event"] },
          "then": { "properties": { "data": { "$ref": "#/$defs/playerState" } } }
        },
        {
          "if": { "properties": { "event": { "const": "asset" } }, "required": ["event"] },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": ["artworkId", "occurrenceId", "mime", "width", "height", "dataBase64"],
                "additionalProperties": false,
                "properties": {
                  "artworkId": { "type": "string", "minLength": 1 },
                  "occurrenceId": { "type": ["string", "null"] },
                  "mime": { "enum": ["image/jpeg", "image/png", "image/webp"] },
                  "width": { "type": "integer", "minimum": 1, "maximum": 768 },
                  "height": { "type": "integer", "minimum": 1, "maximum": 768 },
                  "dataBase64": { "type": "string", "maxLength": 174764 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "event": { "const": "connection" } }, "required": ["event"] },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": ["component", "status"],
                "additionalProperties": false,
                "properties": {
                  "component": { "enum": ["gui", "controller", "target", "helper", "adapter"] },
                  "status": { "enum": ["connected", "disconnected", "degraded"] },
                  "reason": { "type": "string", "maxLength": 500 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "event": { "const": "binding" } }, "required": ["event"] },
          "then": {
            "properties": {
              "data": {
                "type": "object",
                "required": ["status"],
                "additionalProperties": false,
                "properties": {
                  "status": { "enum": ["bound", "unbound", "revoked"] },
                  "reason": { "type": "string", "maxLength": 500 }
                }
              }
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" },
    { "$ref": "#/$defs/event" }
  ]
}
