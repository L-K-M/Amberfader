{
  "manifest_version": 3,
  "name": "Amberfader",
  "version": "0.1.9",
  "description": "Compact classic-style remote control for YouTube Music. Controls playback and search in an existing music.youtube.com tab.",
  "default_locale": "en",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "amberfader@ch.lkmc",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "background": {
    "scripts": ["js/background.js"]
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://music.youtube.com/*", "https://yt3.googleusercontent.com/*"],
  "optional_permissions": ["nativeMessaging", "tabHide"],
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["js/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Open Amberfader player",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
