{
  "name": "amberfader",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Compact classic-style player for YouTube Music with its own embedded browser",
  "license": "Unlicense",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-embedded.mjs",
    "start": "npm run build && uv run python -m amberfader",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "version:check": "node scripts/sync-versions.mjs --check",
    "gen:validators": "node scripts/gen-validators.mjs",
    "gen:validators:check": "node scripts/gen-validators.mjs --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "ajv": "^8.17.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.56.0",
    "vitest": "^5.0.3"
  }
}
